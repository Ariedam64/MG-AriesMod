    "check:reactions": "esbuild scripts/checkCompanionReactions.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkCompanionReactions.cjs --log-level=error && node node_modules/.cache/checkCompanionReactions.cjs",
    "check:wander": "esbuild scripts/checkCompanionWander.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkCompanionWander.cjs --log-level=error && node node_modules/.cache/checkCompanionWander.cjs",
