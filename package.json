{
  "name": "quinoa-ws-hud",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "check": "node scripts/runChecks.mjs",
    "typecheck": "npx -y -p typescript@5 tsc -p .",
    "check:stats": "esbuild scripts/checkTeamStats.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkTeamStats.cjs --log-level=error && node -e \"globalThis.window=globalThis;globalThis.document={};require('./node_modules/.cache/checkTeamStats.cjs')\"",
    "check:identity": "esbuild scripts/checkPlayerIdentity.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkPlayerIdentity.cjs --log-level=error && node node_modules/.cache/checkPlayerIdentity.cjs",
    "check:commands": "esbuild scripts/checkQuinoaCommands.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkQuinoaCommands.cjs --log-level=error && node node_modules/.cache/checkQuinoaCommands.cjs",
    "check:sprites": "esbuild scripts/checkSpriteResolver.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkSpriteResolver.cjs --log-level=error && node node_modules/.cache/checkSpriteResolver.cjs",
    "check:cropsize": "esbuild scripts/checkCropSize.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkCropSize.cjs --log-level=error && node -e \"globalThis.window=globalThis;globalThis.document={};require('./node_modules/.cache/checkCropSize.cjs')\"",
    "check:harvestfilters": "esbuild scripts/checkHarvestFilters.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkHarvestFilters.cjs --log-level=error && node -e \"globalThis.window=globalThis;globalThis.document={};require('./node_modules/.cache/checkHarvestFilters.cjs')\"",
    "check:locker": "esbuild scripts/checkLockerDefaults.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkLockerDefaults.cjs --log-level=error && node -e \"globalThis.window=globalThis;globalThis.document={};globalThis.localStorage={getItem:()=>null,setItem:()=>{},removeItem:()=>{}};require('./node_modules/.cache/checkLockerDefaults.cjs')\"",
    "check:abilitylogs": "esbuild scripts/checkAbilityLogIds.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkAbilityLogIds.cjs --log-level=error && node -r ./scripts/_nodeStub.cjs node_modules/.cache/checkAbilityLogIds.cjs",
    "check:growslot": "esbuild scripts/checkGrowSlot.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkGrowSlot.cjs --log-level=error && node node_modules/.cache/checkGrowSlot.cjs",
    "check:tilecapture": "esbuild scripts/checkTileCapture.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkTileCapture.cjs --log-level=error && node -e \"globalThis.window=globalThis;globalThis.document={};require('./node_modules/.cache/checkTileCapture.cjs')\"",
