    "check:shoppurchases": "esbuild scripts/checkShopPurchases.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkShopPurchases.cjs --log-level=error && node node_modules/.cache/checkShopPurchases.cjs",
    "check:shopmessage": "esbuild scripts/checkShopPurchaseMessage.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkShopPurchaseMessage.cjs --log-level=error && node node_modules/.cache/checkShopPurchaseMessage.cjs",
    "check:moveitem": "esbuild scripts/checkMoveItemMessage.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkMoveItemMessage.cjs --log-level=error && node node_modules/.cache/checkMoveItemMessage.cjs",
    "check:modalstate": "esbuild scripts/checkModalState.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkModalState.cjs --log-level=error && node node_modules/.cache/checkModalState.cjs",
    "check:activitylogmodal": "esbuild scripts/checkActivityLogModal.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkActivityLogModal.cjs --log-level=error && node node_modules/.cache/checkActivityLogModal.cjs",
    "check:discordframes": "esbuild scripts/checkDiscordFrames.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkDiscordFrames.cjs --log-level=error && node node_modules/.cache/checkDiscordFrames.cjs",
    "serve": "npx http-server dist -p 5174 --cors",
    "check:lib": "esbuild scripts/checkLib.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkLib.cjs --log-level=error && node node_modules/.cache/checkLib.cjs",
    "check:environment": "esbuild scripts/checkEnvironment.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkEnvironment.cjs --log-level=error && node node_modules/.cache/checkEnvironment.cjs",
    "check:storagesections": "esbuild scripts/checkStorageSections.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkStorageSections.cjs --log-level=error && node node_modules/.cache/checkStorageSections.cjs",
    "check:cataloglive": "esbuild scripts/checkCatalogLive.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkCatalogLive.cjs --log-level=error && node -r ./scripts/_nodeStub.cjs node_modules/.cache/checkCatalogLive.cjs",
    "check:abilitycolors": "esbuild scripts/checkAbilityChipColors.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkAbilityChipColors.cjs --log-level=error && node -r ./scripts/_nodeStub.cjs node_modules/.cache/checkAbilityChipColors.cjs"
  },
  "devDependencies": {
    "@types/tampermonkey": "^5.0.4",
    "esbuild": "^0.24.2"
  }
}
