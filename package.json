    "check:dialogue": "esbuild scripts/checkCompanionDialogue.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkCompanionDialogue.cjs --log-level=error && node node_modules/.cache/checkCompanionDialogue.cjs",
    "check:storage": "esbuild scripts/checkCompanionStorage.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkCompanionStorage.cjs --log-level=error && node node_modules/.cache/checkCompanionStorage.cjs",
    "check:croppricetoggle": "esbuild scripts/checkCropPriceSetting.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkCropPriceSetting.cjs --log-level=error && node node_modules/.cache/checkCropPriceSetting.cjs",
